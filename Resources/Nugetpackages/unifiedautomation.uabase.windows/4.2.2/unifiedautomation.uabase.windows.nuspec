<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UnifiedAutomation.UaBase.Windows</id>
    <version>4.2.2</version>
    <title></title>
    <authors>Unified Automation GmbH</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">license\UnifiedAutomation_Software_License_Agreement.txt</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>images\unified_eval.png</icon>
    <projectUrl>http://documentation.unified-automation.com/uasdkdotnet/4.2.2/html/index.html</projectUrl>
    <description>Unified Automation OPC UA SDK Windows Library (EVAL)</description>
    <language>en-US</language>
    <tags>Unified Automation OPC-UA dotnet net</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="UnifiedAutomation.UaBase" version="4.2.2" />
      </group>
      <group targetFramework=".NETFramework4.8">
        <dependency id="UnifiedAutomation.UaBase" version="4.2.2" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="UnifiedAutomation.UaBase" version="4.2.2" />
        <dependency id="System.Configuration.ConfigurationManager" version="6.0.0" />
        <dependency id="System.Management" version="6.0.0" />
        <dependency id="System.ServiceModel.Primitives" version="6.0.0" />
        <dependency id="System.ServiceProcess.ServiceController" version="6.0.0" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="UnifiedAutomation.UaBase" version="4.2.2" />
        <dependency id="System.Configuration.ConfigurationManager" version="6.0.0" />
        <dependency id="System.Management" version="6.0.0" />
        <dependency id="System.ServiceModel.Primitives" version="6.0.0" />
        <dependency id="System.ServiceProcess.ServiceController" version="6.0.0" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="..\..\lib\Opc.Ua.CertificateGenerator.exe" buildAction="Content" copyToOutput="true" flatten="true" />
    </contentFiles>
  </metadata>
</package>